platform :ios do
  desc 'Submit the pending review submission (2.0.0 already added) to App Review'
  lane :submit_pending do
    app_store_connect_auth
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    submission = app.get_ready_review_submission(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!('No ready review submission') unless submission
    items = asc_request(:get, "reviewSubmissions/#{submission.id}/items")['data']
    UI.message("Submission #{submission.id} has #{items.size} item(s)")
    submission.submit_for_review
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS) ||
              app.get_app_store_versions(filter: { versionString: VERSION, platform: 'IOS' }).first
    UI.success("Submitted. #{VERSION} state: #{version&.app_store_state}")
  end
end
