# API Keys - copy this to .env and fill in your keys
VEXO_API_KEY=your_vexo_api_key_here

# RevenueCat public SDK keys (recommended: separate per platform)
REVENUECAT_IOS_API_KEY=your_revenuecat_ios_public_sdk_key_here
REVENUECAT_ANDROID_API_KEY=your_revenuecat_android_public_sdk_key_here

# Back-compat fallback (if you only want one env var)
REVENUECAT_API_KEY=your_revenuecat_public_sdk_key_here

# Google Play Games Services APP_ID (numeric) for `expo-stores-games-services`
PLAY_GAMES_APP_ID=your_play_games_app_id_here

# Leaderboards (optional)
LEADERBOARD_NET_PROFIT_IOS=your_game_center_leaderboard_id_here
LEADERBOARD_NET_PROFIT_ANDROID=your_play_games_leaderboard_id_here
